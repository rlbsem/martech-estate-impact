FROM python:3.12.14-slim-bookworm
WORKDIR /app
COPY requirements.lock pyproject.toml ./
RUN pip install --no-cache-dir -r requirements.lock
COPY src ./src
COPY migrations ./migrations
COPY config ./config
COPY fixtures ./fixtures
COPY scripts ./scripts
RUN pip install --no-deps --no-build-isolation . && useradd -u 10001 -m console && mkdir /shared && chown console:console /shared
USER 10001:10001
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
CMD ["python","-m","estate_change.server","--config","/shared/change_console.json","--port","8594","--container"]
